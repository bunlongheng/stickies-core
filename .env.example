# ---- required ----------------------------------------------------------
# Postgres holding the `stickies` table. The full app's database, or your own.
DATABASE_URL="postgresql://user:pass@host:5432/db"
# The one account whose notes this board shows.
OWNER_USER_ID="00000000-0000-0000-0000-000000000000"

# ---- optional ----------------------------------------------------------
# PEM (or its base64) for verifying the database's TLS certificate. Without it
# the connection is encrypted but the server is not verified.
# DATABASE_CA_CERT=

# Where the notes app serves submitter icons from. Rows fall back to a default
# icon when it is unreachable, so this is only ever cosmetic.
# NEXT_PUBLIC_STICKIES_URL="http://localhost:4444"

# Machines that get their own badge in the list instead of the generic one.
# Leave unset unless you actually post notes from named hosts.
# NEXT_PUBLIC_HUB_MACHINE=
# NEXT_PUBLIC_WORKSTATION_MACHINE=

# Empty TRASH permanently. Off unless this is exactly 1, because it is the one
# action in the app that cannot be undone.
# STICKIES_CORE_ALLOW_PURGE=0
